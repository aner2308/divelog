@{
    ViewData["Title"] = "Om oss";
    Layout = "_LayoutPattern";
}

<div>
    <section class="about-card">
        <div class="about-text">
            <h1>Om oss på<br>DiveLogg</h1>
            <img src="/images/logotype.png" alt="Logo">
            <p>
                Divelog startades som ett projekt av Anton Eriksson och Emma Larsson. Grundidén var att
                underlätta för räddningstjänster med dykberedskap att smidigt registrera dyk direkt på plats eller i
                efterhand. Applikationen som utvecklades fick namnet divelog.
                <br><br>
                Divelog har utformats efter räddningsdykaras vardag, och strävar efter att vara lika flexibla som
                dykarna själva kan behöva vara. Är ni intresserade av att höra mer om applikationen? Hör gärna av er för
                en demonstration.
            </p>
        </div>
        <div class="about-image">
            <img src="/images/diver-standing.jpg" alt="Dykare som står på isen">

            <div class="image-overlay1"></div>
            <div class="image-overlay2"></div>
            <div class="image-overlay3"></div>
        </div>
    </section>


</div>