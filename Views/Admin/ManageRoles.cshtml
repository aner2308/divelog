@model divelog.ViewModels.ManageRolesViewModel

<h2>Hantera roll</h2>



<form method="post" class="user-form">

    <h3>@Model.Email</h3>
    
    <input type="hidden" asp-for="UserId" />

    <div asp-validation-summary="All" class="error"></div>

    <div class="form-row">

        <label asp-for="SelectedRole">Roll:</label>

        <select asp-for="SelectedRole" class="form-select">

            @foreach (var role in Model.AvailableRoles)
            {
                <option value="@role">@role</option>
            }

        </select>

    </div>

    <button type="submit" class="update-user-btn">
        Uppdatera roll
    </button>

</form>

<div class="navigate-back">
    <a asp-action="Index">Tillbaka till adminsidan</a>
</div>