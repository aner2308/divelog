@model divelog.ViewModels.CreateUserViewModel

<h2>Skapa användare</h2>

<form method="post" class="user-form">

    <div asp-validation-summary="All" class="error"></div>

    <div class="form-row">
        <label asp-for="Email">Mail:</label>
        <input asp-for="Email" type="email"/>
    </div>

    <div class="form-row">
        <label asp-for="Password">Lösenord:</label>
        <input asp-for="Password" type="password" />
    </div>

    <div class="form-row">
        <label asp-for="Role">Roll: </label>

        <select asp-for="Role">
            <option value="Reader">Läsare</option>
            <option value="Editor">Redigerare</option>
            <option value="Admin">Admin</option>
        </select>
    </div>

    <button type="submit" class="form-btn">
        Skapa användare
    </button>

</form>

<div class="navigate-back">
    <a asp-action="Index">Tillbaka till adminsidan</a>
</div>