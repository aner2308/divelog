@model List<divelog.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Adminsidan";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-message">
        @TempData["SuccessMessage"]
    </div>
}

<div class="user-form">

    <div class="page-header">
        <h2>Adminsidan</h2>

        <a asp-action="CreateUser" class="form-btn">
            + Skapa användare
        </a>
    </div>

    <div class="admin-users-list">

        @foreach (var user in Model)
        {
            <div class="admin-user-card">

                <div class="admin-user-info">

                    <h4>@user.Email</h4>

                    <p>
                        <strong>Roll:</strong>
                        @user.Role
                    </p>

                </div>

                <div class="admin-user-actions">

                    <a asp-action="ManageRoles"
                       asp-route-id="@user.Id"
                       class="user-form-btn">
                        Hantera roll
                    </a>

                    <a asp-action="ResetPassword"
                       asp-route-id="@user.Id"
                       class="user-form-btn">
                        Uppdatera lösenord
                    </a>

                    <a asp-action="DeleteUser"
                       asp-route-id="@user.Id"
                       class="user-form-btn remove-user-btn">
                        Ta bort
                    </a>

                </div>

            </div>
        }

    </div>

</div>