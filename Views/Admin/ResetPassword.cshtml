@model divelog.ViewModels.ResetPasswordViewModel
<!--Sida för att ändra lösenord på en användare-->
<h1>Ändra lösenord</h1>

<form method="post" class="user-form">
    <h3>@Model.Email</h3>
    
    <input type="hidden" asp-for="UserId" />

    <div asp-validation-summary="All" class="error"></div>

    <div class="form-row">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" type="password" />
    </div>

    <div class="form-row">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" />
    </div>

    <button type="submit" class="user-form-btn">
        Spara
    </button>

</form>

<div class="navigate-back">
    <a asp-action="Index">Tillbaka till Admin</a>
</div>